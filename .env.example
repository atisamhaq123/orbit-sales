# Use a NEW Orbit Sales Supabase project. Never use ClientNest credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ORBIT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ORBIT_ANON_KEY
# Server and worker only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_ORBIT_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_ORBIT_OPENAI_KEY
# Choose a model available to your account that supports Chat Completions JSON schema.
OPENAI_CHAT_MODEL=YOUR_STRUCTURED_OUTPUT_CHAT_MODEL
# Embeddings are fixed in code to text-embedding-3-small at 1536 dimensions.
STRIPE_SECRET_KEY=sk_test_YOUR_ORBIT_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_ORBIT_WEBHOOK_SECRET
STRIPE_STARTER_PRICE_ID=price_YOUR_ORBIT_STARTER_19_USD_MONTHLY
STRIPE_PRO_PRICE_ID=price_YOUR_ORBIT_PRO_49_USD_MONTHLY
# Optional browser verification
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
